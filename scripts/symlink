#!/usr/bin/env bash
# Symlink dotfiles into $HOME.
#
# Explicit, no auto-discovery. Add a line per file/dir you want linked.
# Safe to re-run: skips correct links, refuses to overwrite real files.

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

link() {
    local src="$DOTFILES/$1"
    local dest="$HOME/$2"

    if [[ ! -e "$src" ]]; then
        echo "skip $2 — source missing: $src"
        return
    fi

    mkdir -p "$(dirname "$dest")"

    if [[ -L "$dest" ]]; then
        if [[ "$(readlink "$dest")" == "$src" ]]; then
            echo "ok   $2"
            return
        fi
        rm "$dest"
    elif [[ -e "$dest" ]]; then
        echo "skip $2 — exists and is not a symlink"
        return
    fi

    ln -s "$src" "$dest"
    echo "link $2 -> $src"
}

# VSCode/Cursor store user config in different places on macOS vs Linux.
# lazygit is the same story: it only honours XDG when XDG_CONFIG_HOME is set,
# which we don't — so on macOS it reads Library/Application Support instead.
# Verify with `lazygit --print-config-dir` if this ever stops working.
# Everything else (fish, ghostty, starship, git, mise) is XDG and identical.
case "$(uname -s)" in
    Darwin)
        VSCODE_USER="Library/Application Support/Code/User"
        CURSOR_USER="Library/Application Support/Cursor/User"
        LAZYGIT_CONFIG="Library/Application Support/lazygit/config.yml"
        ;;
    Linux)
        VSCODE_USER=".config/Code/User"
        CURSOR_USER=".config/Cursor/User"
        LAZYGIT_CONFIG=".config/lazygit/config.yml"
        ;;
    *)
        echo "warn: unknown OS $(uname -s) — skipping VSCode/Cursor/lazygit links"
        VSCODE_USER=""
        CURSOR_USER=""
        LAZYGIT_CONFIG=""
        ;;
esac

# src (relative to repo)        dest (relative to $HOME)
link  fish                      .config/fish
link  ghostty/config            .config/ghostty/config
link  starship/starship.toml    .config/starship.toml
link  git/ignore                .config/git/ignore
link  git/config                .config/git/config
link  git/config.local          .config/git/config.local
link  mise/config.toml          .config/mise/config.toml
link  herdr/config.toml         .config/herdr/config.toml
link  nvim                      .config/nvim
link  bash/bashrc               .bashrc
link  bash/bash_profile         .bash_profile

# Omarchy-only config. Same detection as scripts/install-dependencies.
if [[ -f /etc/omarchy-release ]] || [[ -d "$HOME/.local/share/omarchy" ]] ||
   command -v omarchy-update >/dev/null 2>&1; then
    link  omarchy/hypr/bindings.lua  .config/hypr/bindings.lua
    link  omarchy/omarchy/extensions/omarchy-menu.jsonc .config/omarchy/extensions/omarchy-menu.jsonc
fi

if [[ -n "$LAZYGIT_CONFIG" ]]; then
    link  lazygit/config.yml        "$LAZYGIT_CONFIG"
fi

# Cursor + VSCode share the same JSON files; path varies by OS (see above).
if [[ -n "$CURSOR_USER" ]]; then
    link  vscode/settings.json      "$CURSOR_USER/settings.json"
    link  vscode/keybindings.json   "$CURSOR_USER/keybindings.json"
    link  vscode/snippets           "$CURSOR_USER/snippets"
fi
if [[ -n "$VSCODE_USER" ]]; then
    link  vscode/settings.json      "$VSCODE_USER/settings.json"
    link  vscode/keybindings.json   "$VSCODE_USER/keybindings.json"
    link  vscode/snippets           "$VSCODE_USER/snippets"
fi
