# ~/.bashrc — interactive shell init.
# Kept lean: bash is the "fallback" shell (servers, CI, broken setups);
# real day-to-day config lives in fish.

# Bail early for non-interactive shells (scp, scripts, etc).
case $- in *i*) ;; *) return ;; esac

# --- Environment ----------------------------------------------------------
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

export EDITOR=cursor
export VISUAL=cursor
export PAGER=less
export LESS='-R --mouse --wheel-lines=3'

export PATH="$HOME/.local/bin:$HOME/.dotfiles/bin:$PATH"

# Homebrew shellenv on whichever prefix exists (Apple Silicon vs Intel/Linux).
for brew_prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
    if [[ -x "$brew_prefix/bin/brew" ]]; then
        eval "$("$brew_prefix/bin/brew" shellenv)"
        break
    fi
done

# --- History --------------------------------------------------------------
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth         # skip dups and lines starting with space
shopt -s histappend            # append on exit instead of overwriting

# --- Shell behavior -------------------------------------------------------
shopt -s checkwinsize          # update LINES/COLUMNS after each command
shopt -s nocaseglob            # case-insensitive glob

# `globstar` (** for recursive glob) is bash 4.0+. macOS ships 3.2.
# Guard so the 3.2 case doesn't error out at shell startup.
if (( BASH_VERSINFO[0] >= 4 )); then
    shopt -s globstar
fi

# --- Shared aliases (same file fish reads) --------------------------------
[[ -f "$HOME/.dotfiles/shell/aliases.sh" ]] && source "$HOME/.dotfiles/shell/aliases.sh"

# --- Tool integrations ----------------------------------------------------
# All guarded so missing tools don't error out the shell.
command -v starship >/dev/null && eval "$(starship init bash)"
command -v zoxide   >/dev/null && eval "$(zoxide init bash --cmd cd)"
command -v fzf      >/dev/null && eval "$(fzf --bash 2>/dev/null)"
command -v mise     >/dev/null && eval "$(mise activate bash)"
