# ~/.bashrc — interactive shell init.
# Kept lean: bash is the "fallback" shell (servers, CI, broken setups);
# real day-to-day config lives in fish.

# Bail early for non-interactive shells (scp, scripts, etc).
case $- in *i*) ;; *) return ;; esac

# --- Environment ----------------------------------------------------------
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

export EDITOR=cursor
export VISUAL=cursor
export PAGER=less
export LESS='-R --mouse --wheel-lines=3'

export PATH="$HOME/.local/bin:$HOME/.dotfiles/bin:$PATH"

# Homebrew shellenv on whichever prefix exists (Apple Silicon vs Intel/Linux).
for brew_prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
    if [[ -x "$brew_prefix/bin/brew" ]]; then
        eval "$("$brew_prefix/bin/brew" shellenv)"
        break
    fi
done

# --- History --------------------------------------------------------------
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth         # skip dups and lines starting with space
HISTTIMEFORMAT="%F %T  "       # timestamps in `history` output
shopt -s histappend            # append on exit instead of overwriting

# Sync history across concurrent shells: after each command, flush to file
# and re-read what other shells wrote. Other tools (mise, starship) also
# hook PROMPT_COMMAND, so prepend rather than overwrite.
PROMPT_COMMAND="history -a; history -n; ${PROMPT_COMMAND:-}"

# --- Shell behavior -------------------------------------------------------
shopt -s checkwinsize          # update LINES/COLUMNS after each command
shopt -s nocaseglob            # case-insensitive glob

# bash 4.0+ niceties. macOS ships 3.2, so guard.
if (( BASH_VERSINFO[0] >= 4 )); then
    shopt -s globstar          # `**` matches recursively
    shopt -s cdspell           # auto-correct typos in cd paths
    shopt -s autocd            # `mydir` (no `cd`) cds into it
fi

# Readline / key bindings.
# Up/Down with a prefix already typed cycles through matching history
# (type `git ` then ↑ → walks past git commands). Much more useful than
# the default plain history walk.
bind '"\e[A": history-search-backward' 2>/dev/null
bind '"\e[B": history-search-forward'  2>/dev/null

# Tab cycles through completions instead of just listing them (zsh/fish-style).
# show-all-if-ambiguous: show the list on the FIRST ambiguous Tab (default
# requires two). menu-complete-display-prefix: fill the common prefix first,
# then cycle.
bind 'set show-all-if-ambiguous on'      2>/dev/null
bind 'set menu-complete-display-prefix on' 2>/dev/null
bind 'TAB: menu-complete'                2>/dev/null
bind '"\e[Z": menu-complete-backward'    2>/dev/null  # Shift-Tab

# --- Aliases + functions --------------------------------------------------
# Cross-shell aliases (also sourced by fish):
[[ -f "$HOME/.dotfiles/shell/aliases.sh" ]] && source "$HOME/.dotfiles/shell/aliases.sh"
# Bash-only aliases (ls family, etc.):
[[ -f "$HOME/.dotfiles/bash/aliases.sh" ]]  && source "$HOME/.dotfiles/bash/aliases.sh"
# Bash functions, one per file under bash/functions/ (mirrors fish layout).
# Unlike fish these aren't lazy-loaded — bash has no on-demand mechanism — so
# everything is sourced at shell start.
if [[ -d "$HOME/.dotfiles/bash/functions" ]]; then
    for fn in "$HOME/.dotfiles/bash/functions"/*.sh; do
        [[ -r "$fn" ]] && source "$fn"
    done
    unset fn
fi

# --- bash-completion ------------------------------------------------------
# Tab-complete subcommands and flags for git, docker, gh, npm, etc.
[[ -f "$HOME/.dotfiles/bash/completion.sh" ]] && source "$HOME/.dotfiles/bash/completion.sh"

# --- Tool integrations ----------------------------------------------------
# All guarded so missing tools don't error out the shell.
command -v starship >/dev/null && eval "$(starship init bash)"
command -v zoxide   >/dev/null && eval "$(zoxide init bash --cmd cd)"
command -v fzf      >/dev/null && eval "$(fzf --bash 2>/dev/null)"
command -v mise     >/dev/null && eval "$(mise activate bash)"
