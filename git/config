[include]
	path = ~/.config/git/config.local

[init]
	defaultBranch = main

[pull]
	rebase = true
	ff = only

[push]
	autoSetupRemote = true     # no more `--set-upstream` on first push
	followTags = true

[fetch]
	prune = true               # delete local refs for remote branches that are gone
	pruneTags = true

[rebase]
	autosquash = true
	autostash = true
	updateRefs = true          # git 2.38+, rebases stacked branches together

[merge]
	conflictstyle = zdiff3     # shows common ancestor in conflicts — much clearer

[diff]
	algorithm = histogram
	colorMoved = default       # highlight moved code distinctly
	mnemonicPrefix = true
	renames = true

[branch]
	sort = -committerdate      # newest branches first in `git branch`

[tag]
	sort = version:refname     # semver-aware

[column]
	ui = auto

[commit]
	verbose = true             # show diff in the commit message editor

[rerere]
	enabled = true             # remember conflict resolutions

[help]
	autocorrect = prompt       # ask before correcting typos

[alias]
	co = checkout
	sw = switch
	rs = restore
	count = shortlog -sn
	branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\\t%(color:red)%(authorname)\\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
