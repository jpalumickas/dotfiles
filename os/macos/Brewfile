# Homebrew formulae — CLI tools.
# Run via os/macos/install (which calls `brew bundle`).

# Shell + prompt
brew "fish"
brew "starship"
brew "bash"                  # modern bash 5+, replaces macOS's bash 3.2
brew "bash-completion@2"     # tab completion for git/docker/gh/npm/…
brew "zsh"                   # macOS ships zsh 5.9; brew keeps it fresh

# Editor + multiplexer
brew "neovim"
brew "tmux"

# Version manager
brew "mise"

# Git
brew "git"
brew "gh"
brew "git-delta"

# Modern CLI replacements
brew "ripgrep"   # grep
brew "fd"        # find
brew "fzf"       # fuzzy finder
brew "bat"       # cat
brew "eza"       # ls
brew "zoxide"    # cd
brew "jq"        # json
