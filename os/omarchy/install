#!/usr/bin/env bash
# Update Omarchy and install the extra packages in packages.txt.
#
#   ./install              # omarchy-update, then packages
#   ./install --no-update  # skip omarchy-update, just install packages

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DO_UPDATE=1
[[ "${1:-}" == "--no-update" ]] && DO_UPDATE=0

# Omarchy's bin directory may be absent from non-interactive shells.
PATH="$HOME/.local/share/omarchy/bin:$PATH"

if [[ $DO_UPDATE -eq 1 ]]; then
    if command -v omarchy-update >/dev/null 2>&1; then
        echo "==> omarchy-update"
        omarchy-update
    else
        echo "warn: omarchy-update not found — skipping system update" >&2
    fi
else
    echo "==> omarchy-update (skipped)"
fi

echo "==> removing unwanted Omarchy web apps"
"$HERE/remove-webapps"

echo "==> installing packages from omarchy/packages.txt"
packages=()
while IFS= read -r line; do
    line="${line%%#*}"
    line="$(echo -n "$line" | xargs)"
    [[ -n "$line" ]] && packages+=("$line")
done < "$HERE/packages.txt"

if [[ ${#packages[@]} -eq 0 ]]; then
    echo "==> nothing to install"
elif command -v omarchy-pkg-add >/dev/null 2>&1; then
    echo "==> omarchy-pkg-add ${packages[*]}"
    omarchy-pkg-add "${packages[@]}"
else
    echo "warn: omarchy-pkg-add not found — falling back to pacman" >&2
    sudo pacman -S --needed --noconfirm "${packages[@]}"
fi

# Register fish as a login shell.
if command -v fish >/dev/null 2>&1; then
    fish_path="$(command -v fish)"
    if ! grep -qxF "$fish_path" /etc/shells; then
        echo "==> adding $fish_path to /etc/shells"
        echo "$fish_path" | sudo tee -a /etc/shells >/dev/null
    fi
fi

echo "==> done"
